#!/command/with-contenv bashio
# ==============================================================================
# Home Assistant Add-on: Fleet Assistant Connector
# Runs WireGuard
# ==============================================================================
declare interface

bashio::log.info "Starting WireGuard..."

# Get the interface
interface="fleet-assistant"

# wg-quick echoes every command it runs prefixed with "[#]" — routine noise.
# Filter those out but keep everything else (actual errors/warnings intact).
wg-quick up "${interface}" 2>&1 | grep -v '^\[#\]' >&2
exit "${PIPESTATUS[0]}"
